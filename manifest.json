{
  "manifest_version": 2,
  "name": "DTU Lautschrift-Übersetzer",
  "version": "1.1",
  "description": "Ersetzt Phonetik-Blöcke von DDO zu Kiel,SchwaTilgung auf ordnet.dk",
  "permissions": ["https://ordnet.dk/*", "https://gammel.ordnet.dk/*"],
  "web_accessible_resources": [
    "src/translationTable.csv"
  ],
  "content_scripts": [
    {
      "matches": ["https://ordnet.dk/*", "https://gammel.ordnet.dk/*"],
      "css": ["src/styles.css"],
      "js": ["dist/content-script.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["websiteContent"],
        "optional": []
      }
    }
  }
}

